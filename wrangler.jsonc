{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mw-spellbook-builder",
  "compatibility_date": "2026-10-19",
  // Static assets only, no Worker script: unknown paths fall back to index.html for client-side routing.
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "mw-spellbook-builder.cckarchev.ar",
      "custom_domain": true
    }
  ]
}
